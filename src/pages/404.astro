---
import Base from '../layouts/Base.astro'
---

<Base title="Not found" description="That page does not exist.">
  <section class="wrap page-hero" data-section="not-found" data-gl="page">
    <p class="eyebrow">404</p>
    <h1 class="page-title" data-split>Nothing<br />here.</h1>
    <p class="lede" style="margin-top:2rem">
      The page you were looking for moved, or never existed. The work and the about page are still
      where you left them.
    </p>
    <p style="margin-top:2.5rem">
      <a class="btn btn-accent" href="/">Back home</a>
      <a class="btn" href="/projects/" style="margin-left:.5rem">See the work</a>
    </p>
  </section>
</Base>
