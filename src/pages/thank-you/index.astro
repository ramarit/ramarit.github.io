    <p class="eyebrow">Thank you</p>
    <h1 class="page-title" data-split>Message<br />received.</h1>
    <p class="lede" style="margin-top:2rem">
      I'll get back to you within a day or two. In the meantime, the work is the best place to look.
    </p>
    <p style="margin-top:2.5rem">
      <a class="btn btn-accent" href="/projects/">See the work <span class="btn-arrow" aria-hidden="true">→</span></a>
    </p>
  </section>
</Base>
