---
const path = Astro.url.pathname
const isWork = path.startsWith('/projects')
const isAbout = path.startsWith('/about')
const isContact = path.startsWith('/contact')
---

<header class="site-header">
  <a href="/" class="logo" aria-label="Ryan Amarit, home" data-magnetic>
    <img src="/favicon.ico" alt="" height="24" width="24" />
  </a>
  <nav class="nav" aria-label="Main">
    <a href="/projects/" aria-current={isWork ? 'page' : undefined}>Work</a>
    <a href="/about/" aria-current={isAbout ? 'page' : undefined}>About</a>
    <a href="/contact/" aria-current={isContact ? 'page' : undefined}>Contact</a>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme">
      <svg class="theme-icon" viewBox="0 0 20 20" aria-hidden="true">
        <circle cx="10" cy="10" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M10 1.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor"></path>
      </svg>
    </button>
  </nav>
</header>
