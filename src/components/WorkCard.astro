---
import type { Project } from '../content/work'
import Shot from './Shot.astro'
interface Props {
  project: Project
  index: number
}
const { project, index } = Astro.props
const href = project.caseStudy ? `/projects/${project.slug}/` : project.href
const external = !project.caseStudy
---

<article class="work-card" data-work-card>
  <a
    href={href}
    class="work-link"
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
    data-track="project_link_clicked"
    data-track-name={project.title}
    aria-label={`${project.title}: ${project.caseStudy ? 'read the case study' : 'visit the site (opens in a new tab)'}`}
    style="position:absolute;inset:0;z-index:2"></a>
  <div class="work-cover" style={`--h:${project.hue}`} aria-hidden="true">
    <div class="art" data-parallax></div>
    <div class="grid-dots"></div>
    {project.shot && <Shot src={project.shot} sizes="(min-width: 1000px) 40vw, (min-width: 700px) 32vw, 64vw" />}
    <span class="index">{String(index + 1).padStart(2, '0')}</span>
  </div>
  <div class="work-body">
    <div class="work-meta">
      <span>{project.client}</span><span>{project.year}</span><span>{project.role}</span>
    </div>
    <h3 class="work-title">{project.title}</h3>
    <p class="work-summary">{project.summary}</p>
    {project.award && <p class="award">★ {project.award}</p>}
    <ul class="tags">{project.tags.map((t) => <li>{t}</li>)}</ul>
    <span class="work-cta">{project.caseStudy ? 'Read the case study →' : 'Visit the site ↗'}</span>
  </div>
</article>
