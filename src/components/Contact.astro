---
import { site } from '../content/site'

interface Props {
  /** On /contact/ the big line is the page's h1 and a short note follows it. */
  page?: boolean
}
const { page = false } = Astro.props
const Heading = page ? 'h1' : 'div'
---

<section id="contact" class:list={['wrap contact', { 'contact-page': page }]} data-section="contact" data-gl="contact">
  <p class="eyebrow">Contact</p>
  <Heading class="contact-heading">
    <a class="contact-big" href={`mailto:${site.email}`} data-contact-big data-track="social_link_clicked" data-track-name="email">
      Let's build<br /> something.
    </a>
  </Heading>
  {page && <p class="lede contact-note">Email is the quickest way to reach me. I usually reply within a day or two.</p>}
  <div class="contact-links">
    <a
      class="btn btn-accent btn-lg btn-email magnet"
      href={`mailto:${site.email}`}
      data-magnetic
      data-track="social_link_clicked"
      data-track-name="email">{site.email} <span class="btn-arrow" aria-hidden="true">→</span></a
    >
    <a
      class="btn btn-lg magnet"
      href={site.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      data-magnetic
      data-track="social_link_clicked"
      data-track-name="linkedin">LinkedIn <span class="btn-arrow" aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a
    >
  </div>
</section>
