---
import { experience, education } from '../content/experience'
---

<section id="experience" class="wrap timeline" data-section="experience" data-gl="experience">
  <p class="eyebrow">Experience</p>
  <h2 class="h-section" data-split>Where I’ve<br />worked</h2>
  <ol class="tl" data-tl>
    <li class="tl-line" aria-hidden="true"><i data-tl-draw></i></li>
    {
      experience.map((role) => (
        <li class="tl-item" data-tl-item>
          <h3 class="tl-company">
            {role.company}
            <small>
              {role.note ? `${role.note} · ` : ''}
              {role.place} · {role.dates}
            </small>
          </h3>
          <ul class="tl-titles">
            {role.titles.map((t) => (
              <li>
                <span>{t.title}</span>
                <span>{t.dates}</span>
              </li>
            ))}
          </ul>
          <ul class="tl-points">
            {role.points.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        </li>
      ))
    }
    <li class="tl-item" data-tl-item>
      <h3 class="tl-company">Education</h3>
      <ul class="tl-points" style="list-style:none;padding:0">
        {education.map((e) => <li>{e}</li>)}
      </ul>
    </li>
  </ol>
</section>
